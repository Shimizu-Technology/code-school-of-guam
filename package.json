    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.453.0",
    "next": "^15.5.15",
    "openai": "^6.10.0",
    "posthog-js": "^1.369.3",
    "posthog-node": "^4.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
